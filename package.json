{
  "name": "str-companion",
  "productName": "STR Companion",
  "version": "1.0.0",
  "description": "Setup, cleanup, config and launch companion for Skyrim Together Reborn co-op.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.strcompanion",
    "productName": "STR Companion",
    "files": [
      "src/**/*",
      "data/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/7zip-bin/**/*"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "STR-Companion-${version}.exe"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "license": "MIT",
  "author": "clawdroppin",
  "repository": {
    "type": "git",
    "url": "https://github.com/clawdroppin/str-companion.git"
  }
}
