{
  "name": "str-companion",
  "productName": "STR Companion",
  "version": "1.6.0",
  "description": "Setup, cleanup, config and launch companion for Skyrim Together Reborn co-op (Windows, Linux and Steam Deck).",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win portable",
    "dist:linux": "electron-builder --linux AppImage tar.gz",
    "ui-check": "node scripts/ui-check.js"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.1"
  },
  "build": {
    "appId": "local.strcompanion",
    "productName": "STR Companion",
    "files": [
      "src/**/*",
      "data/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/7zip-bin/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "STR-Companion-${version}.exe"
    },
    "directories": {
      "buildResources": "build"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "synopsis": "Skyrim Together Reborn co-op companion",
      "artifactName": "STR-Companion-${version}-linux-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "electron@45.2.1": true
  },
  "license": "MIT",
  "author": {
    "name": "clawdroppin",
    "email": "69279861+clawdroppin@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/clawdroppin/str-companion.git"
  },
  "homepage": "https://github.com/clawdroppin/str-companion"
}
